# ─────────────────────────────────────────────────────────────────────────────
# Sanity — required
# Get your project ID and dataset from https://sanity.io/manage
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity write token — needed only for user registration (creates userProfile docs)
# Create a token at: https://sanity.io/manage → your project → API → Tokens
# Required permissions: Editor (or custom with write access to userProfile documents)
SANITY_TOKEN=your_sanity_write_token

# ─────────────────────────────────────────────────────────────────────────────
# App URL — used for email links (verify, reset password)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Auth — JWT secret for signing session tokens
# Use a strong random string (e.g. openssl rand -hex 32)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret

# ─────────────────────────────────────────────────────────────────────────────
# SMTP — for contact form and auth emails
# Office 365 example shown; works with any SMTP provider
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=your@email.com
FROM_NAME=Your Site Name

# ─────────────────────────────────────────────────────────────────────────────
# PostHog analytics (optional)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
