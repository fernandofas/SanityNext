# ─────────────────────────────────────────────────────────────────────────────
# Sanity Studio environment variables
# Copy this file to .env and fill in your values.
# Never commit the .env file — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Your Sanity project ID — find it at https://sanity.io/manage
SANITY_STUDIO_PROJECT_ID=your_sanity_project_id

# Dataset name (usually "production")
SANITY_STUDIO_DATASET=production

# Sanity write token (optional — only needed for migration scripts)
# Create a token at: https://sanity.io/manage → your project → API → Tokens
# SANITY_TOKEN=your_sanity_write_token
